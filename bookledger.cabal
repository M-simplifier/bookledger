cabal-version: 3.4
name: bookledger
version: 0.1.0.0
license: MIT
license-file: LICENSE
author: Masaya Shirasawa
maintainer: masaya@example.com
synopsis: Small local-first book ledger
description: A minimal SQLite-backed book ledger with a CLI, local web UI, and snapshot backups.
category: Tools
build-type: Simple
extra-source-files:
  README.md
  schema.sql
  example-config.toml
  test/web/*.test.cjs
  src/BookLedger/Export/viewer.html
  src/BookLedger/Export/viewer.css
  src/BookLedger/Export/viewer.js
data-files:
  static/index.html
  static/app.js
  static/model.js
  static/store.js
  static/style.css

common warnings
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wpartial-fields -Wredundant-constraints

library bookledger-core
  import: warnings
  hs-source-dirs:
    src
  exposed-modules:
    BookLedger.Actions
    BookLedger.Backup
    BookLedger.Config
    BookLedger.Domain
    BookLedger.Export
    BookLedger.Store
    BookLedger.Web
  other-modules:
    Paths_bookledger
    BookLedger.Export.Assets
  autogen-modules:
    Paths_bookledger
  build-depends:
    aeson >= 2.0 && < 2.3,
    base >= 4.18 && < 4.21,
    bytestring >= 0.11 && < 0.13,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    http-types >= 0.12 && < 0.13,
    process >= 1.6 && < 1.7,
    sqlite-simple >= 0.4 && < 0.5,
    template-haskell >= 2.20 && < 2.23,
    temporary >= 1.3 && < 1.4,
    text >= 2.0 && < 2.2,
    time >= 1.12 && < 1.13,
    wai >= 3.2 && < 3.3,
    warp >= 3.3 && < 3.5
  default-language: GHC2021

executable books
  import: warnings
  ghc-options: -threaded
  main-is: Main.hs
  hs-source-dirs:
    app
  build-depends:
    base >= 4.18 && < 4.21,
    bookledger:bookledger-core,
    optparse-applicative >= 0.18 && < 0.20,
    text >= 2.0 && < 2.2
  default-language: GHC2021

test-suite bookledger-test
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs:
    test
  other-modules:
    BookLedger.BackupTest
    BookLedger.ActionsTest
    BookLedger.DomainTest
    BookLedger.ExportTest
    BookLedger.StoreTest
    BookLedger.TestSupport
    BookLedger.WebTest
  build-depends:
    aeson >= 2.0 && < 2.3,
    base >= 4.18 && < 4.21,
    bookledger:bookledger-core,
    bytestring >= 0.11 && < 0.13,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    http-types >= 0.12 && < 0.13,
    sqlite-simple >= 0.4 && < 0.5,
    tasty >= 1.5 && < 1.6,
    tasty-hunit >= 0.10 && < 0.11,
    temporary >= 1.3 && < 1.4,
    text >= 2.0 && < 2.2,
    time >= 1.12 && < 1.13,
    wai >= 3.2.4 && < 3.3
  default-language: GHC2021
